{%- from "icons.njk" import phone -%}
<header class="site-header">
  <div class="hdr">
    <a class="hdr__logo" href="/" aria-label="ShadowCaster Keys Flats Fishing home"><img src="/images/frame-181.webp" width="461" height="179" alt="ShadowCaster Keys Flats Fishing logo"></a>
    <div class="hdr__right">
      <div class="hdr__top">
        <a class="hdr__phone" href="{{ site.phone_link }}" aria-label="Call {{ site.phone }}">{{ phone() | safe }}<span>{{ site.phone }}</span></a>
        <a class="hdr__book" href="{{ site.booking_url }}" target="_blank" rel="noopener">Book Now</a>
      </div>
      <nav class="hdr__nav" aria-label="Main">
        <ul>
        {%- for item in site.nav %}
          <li class="{{ 'has-sub' if item.children }}{{ ' is-active' if page.url == item.url or (item.children and (item.children | find('url', page.url))) }}">
            <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {%- if item.children %}
            <ul class="sub">{% for c in item.children %}<li><a href="{{ c.url }}"{% if page.url == c.url %} aria-current="page"{% endif %}>{{ c.label }}</a></li>{% endfor %}</ul>
            {%- endif %}
          </li>
        {%- endfor %}
        </ul>
      </nav>
      <button class="hdr__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="mnav" id="mnav" hidden>
    <button class="mnav__close" aria-label="Close menu">&times;</button>
    <img src="/images/image-1-5.webp" width="308" height="107" alt="" class="mnav__logo">
    <ul>
    {%- for item in site.nav %}
      <li><a href="{{ item.url if item.url != '#' else item.children[0].url }}">{{ item.label }}</a>
      {%- if item.children %}<ul>{% for c in item.children %}<li><a href="{{ c.url }}">{{ c.label }}</a></li>{% endfor %}</ul>{% endif %}</li>
    {%- endfor %}
    </ul>
    <a class="mnav__phone" href="{{ site.phone_link }}">{{ phone() | safe }} {{ site.phone }}</a>
    <a class="btn" href="{{ site.booking_url }}" target="_blank" rel="noopener"><span>Book Now</span></a>
  </div>
</header>
