{%- if s.eyebrow or s.heading or s.intro -%}
<div class="sechead{{ ' center' if (s.align or 'center') == 'center' }}">
  {%- if s.eyebrow %}<span class="eyebrow">{{ s.eyebrow }}</span>{% endif %}
  {%- if s.heading %}<h2{% if s.heading_size == 'xl' %} class="h-xl"{% endif %}>{{ s.heading | accent | safe }}</h2>{% endif %}
  {%- if s.heading and s.divider != false %}<span class="divider"></span>{% endif %}
  {%- if s.intro %}<div class="intro">{{ s.intro | md | safe }}</div>{% endif %}
</div>
{%- endif -%}
